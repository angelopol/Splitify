{
  "name": "splitify",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": { "deepmerge-ts": "^8.0.0" },
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  },
  "scripts": {
    "dev": "next dev",
